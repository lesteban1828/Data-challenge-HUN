# Copiar este archivo como ".env" y llenarlo con LOS MISMOS datos de la conexión en DBeaver.
# .env NO se sube a GitHub (está en .gitignore). Requiere FortiClient VPN conectada.

# Motor (en DBeaver: clic derecho en la conexión > Edit Connection > se ve el driver)
#   PostgreSQL  -> postgresql+psycopg2
#   SQL Server  -> mssql+pyodbc        (requiere "ODBC Driver 18 for SQL Server" instalado en Windows)
#   MySQL       -> mysql+pymysql
#   Oracle      -> oracle+oracledb
DB_DIALECT=postgresql+psycopg2
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Esquema donde están las tablas OMOP (en DBeaver: Database > Schemas). Vacío = esquema por defecto.
DB_SCHEMA=uninorte_omop
# Esquema de la tabla CONCEPT si está en uno distinto (p. ej. "vocab"). Vacío = el mismo de arriba.
DB_VOCAB_SCHEMA=

# Solo SQL Server: driver ODBC instalado
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Alternativa: URL completa (si se define, ignora lo anterior)
# DB_URL=postgresql+psycopg2://usuario:clave@host:5432/base

# Carpeta de datos fuera del repo (por defecto D:/HUN_DataChallenge_datos)
# HUN_DATA_DIR=D:/HUN_DataChallenge_datos
