				    Tipos = Table.TransformColumnTypes(Encabezados, {{"fecha", type date}, {"anio", type text}, {"mes", type text}, {"anio_mes", type text}, {"nombre_mes", type text}, {"trimestre", type text}, {"dia_semana", type text}, {"dia_nombre", type text}}, "en-US")
