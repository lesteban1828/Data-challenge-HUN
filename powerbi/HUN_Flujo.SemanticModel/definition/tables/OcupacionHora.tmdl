	partition OcupacionHora = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(Ruta & "OcupacionHora.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"dia", type text}, {"hora", type text}, {"ocupacion", type number}, {"dia_nombre", type text}, {"hora_txt", type text}}, "en-US")
				in
				    Tipos

