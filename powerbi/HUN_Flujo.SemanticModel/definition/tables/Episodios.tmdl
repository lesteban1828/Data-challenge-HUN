	partition Episodios = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(Ruta & "Episodios.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"episodio_id", Int64.Type}, {"fecha", type date}, {"inicio", type datetime}, {"los_h", type number}, {"tipo_episodio", type text}, {"tipo_detalle", type text}, {"los_atipica", Int64.Type}, {"hospitalizado", Int64.Type}, {"h_triage", type number}, {"h_atencion_urg", type number}, {"h_hospitalizacion", type number}, {"h_hasta_hosp", type number}, {"rango_espera_cama", type text}, {"n_areas_urg", Int64.Type}, {"n_labs", type number}, {"n_dx", type number}, {"n_proc", type number}, {"edad", type number}, {"grupo_edad", type text}, {"sexo", type text}, {"hora_llegada", Int64.Type}, {"dia_semana", Int64.Type}, {"dia_nombre", type text}, {"franja", type text}, {"festivo", Int64.Type}, {"episodios_previos", Int64.Type}, {"reconsulta_72h", Int64.Type}, {"ocupacion_urg_llegada", type number}, {"dx_principal_nombre", type text}, {"orden_edad", Int64.Type}}, "en-US")
				in
				    Tipos

