table Episodios
	lineageTag: dc8f23f2-f6d0-4491-b5af-0c0ac7cd822f

	measure 'Episodios' = COUNTROWS ( Episodios )
		formatString: #,0
		lineageTag: 2a42d20a-cc31-4085-a7d9-5e11fc2b7fef

	measure 'Episodios por día' = DIVIDE ( [Episodios], DISTINCTCOUNT ( Episodios[fecha] ) )
		formatString: #,0
		lineageTag: d857760a-5035-4435-9ceb-79e31456918a

	measure 'Episodios válidos' = CALCULATE ( [Episodios], Episodios[los_atipica] = 0 )
		formatString: #,0
		lineageTag: 21f4bf41-306d-4649-a77d-64e2e6bf9a9a

	measure '% hospitalizados' = DIVIDE ( CALCULATE ( [Episodios válidos], Episodios[hospitalizado] = 1 ), [Episodios válidos] )
		formatString: 0.0%
		lineageTag: 0436e246-8178-4920-941c-cec7db36e3a9

	measure 'Espera de cama mediana (h)' = CALCULATE ( MEDIAN ( Episodios[h_hasta_hosp] ), Episodios[tipo_detalle] = "Urgencias → Hospitalización" )
		formatString: 0.0
		lineageTag: 20a133f5-c4b5-4b5b-aa14-516c18bbf2d2

	measure 'Espera de cama P90 (h)' = CALCULATE ( PERCENTILEX.INC ( FILTER ( Episodios, NOT ISBLANK ( Episodios[h_hasta_hosp] ) ), Episodios[h_hasta_hosp], 0.9 ), Episodios[tipo_detalle] = "Urgencias → Hospitalización" )
		formatString: 0.0
		lineageTag: 6dff138c-1688-4e5c-86f1-d8958dffda89

	measure 'Observación mediana (h)' = CALCULATE ( MEDIAN ( Episodios[los_h] ), Episodios[tipo_detalle] = "Urgencias con observación", Episodios[los_atipica] = 0 )
		formatString: 0.0
		lineageTag: bbf5d448-f5d4-44cd-9e3d-ec24676cf7a2

	measure 'Estancia mediana (h)' = CALCULATE ( MEDIAN ( Episodios[los_h] ), Episodios[los_atipica] = 0 )
		formatString: 0.0
		lineageTag: 5df40cb0-ec70-4a83-82bc-2c2fee60889b

	measure 'Estancia P90 (h)' = CALCULATE ( PERCENTILEX.INC ( Episodios, Episodios[los_h], 0.9 ), Episodios[los_atipica] = 0 )
		formatString: 0.0
		lineageTag: 9084803c-ee78-4ab5-ad18-342976fb3b20

	measure '% atenciones breves' = DIVIDE ( CALCULATE ( [Episodios válidos], Episodios[tipo_detalle] = "Urgencias breve (<15 min)" ), [Episodios válidos] )
		formatString: 0%
		lineageTag: d4df3070-b5b1-4916-a977-23736c3e539d

	measure '% reconsulta 72 h' = CALCULATE ( AVERAGE ( Episodios[reconsulta_72h] ), Episodios[los_atipica] = 0 )
		formatString: 0.0%
		lineageTag: 0d2e3e11-3f9d-4e21-897c-239864a9b343

	measure 'Hospitalizados desde urgencias' = CALCULATE ( [Episodios], Episodios[tipo_detalle] = "Urgencias → Hospitalización" )
		formatString: #,0
		lineageTag: 1c275c87-4d1b-4790-8b0f-48ab4c4157f4

	measure 'Pacientes en urgencias (promedio)' = AVERAGE ( OcupacionHora[ocupacion] )
		formatString: #,0
		lineageTag: 3ddc4788-88cd-4245-97e0-04bf1660ac2f

	measure 'Pico de ocupación' = MAX ( OcupacionDiaria[pico] )
		formatString: #,0
		lineageTag: 13a80958-52eb-4964-a312-3a37fad26eed

	measure 'Riesgo de saturación' = VAR p = MAX ( Pronostico[prob_saturacion] ) RETURN SWITCH ( TRUE (), p >= 50, "Alto", p >= 30, "Medio", "Bajo" )
		lineageTag: ad5f1438-03a7-4fd0-a43d-0023e7e116ae

